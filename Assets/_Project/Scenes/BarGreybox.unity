  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LastCallCrew.Network.NpcDialogue
  ShowTopMostFoldoutHeaderGroup: 1
  npcName: Marcel
  prompt: "Psst\u2026 je vends des cravates pour canards. T'en veux une ?"
  choices:
  - Acheter trois cravates
  - Demander l'avis du canard
  - "Refuser, j'ai d\xE9j\xE0 un canard"
  reactions:
  - "MERCI ! Le canard sera tr\xE8s \xE9l\xE9gant ce soir."
  - "Le canard a dit \xAB coin \xBB. Je prends \xE7a pour un oui."
  - "Pas grave. Il portera un n\u0153ud papillon alors."
  reactionSeconds: 3
  npcCollider: {fileID: 805807652}
